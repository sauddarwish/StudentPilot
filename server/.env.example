# ==========================================================================
# Cram server configuration
#
# Copy to server/.env, then:  node set-password.js
# .env must be mode 600 and is git-ignored — never commit it.
# ==========================================================================

# ---- where the process listens (nginx proxies to this) --------------------
HOST=127.0.0.1
PORT=8080

# ---- site password -------------------------------------------------------
# Written by `node set-password.js`. Format: scrypt$<saltHex>$<keyHex>
SITE_PASSWORD_HASH=

# Plaintext fallback — only used if SITE_PASSWORD_HASH is empty. Prefer the hash.
#SITE_PASSWORD=

# Signs session cookies. Any long random string; changing it logs everyone out.
SESSION_SECRET=

SESSION_HOURS=12
SECURE_COOKIE=true

# ---- model API keys ------------------------------------------------------
# These stay on the server. The browser posts to /api/v1/messages on this
# origin and the key is attached here, so it never reaches the client.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- managed mode --------------------------------------------------------
# true  = the browser may not choose its own endpoint, key or token budget.
#         The Connections editor becomes read-only and every request is
#         rewritten server-side to use the settings above.
# false = users can add their own connections and keys in the UI.
MANAGED_MODE=true

# If set, this model is forced onto every request regardless of what the
# client asked for. Leave empty to let pilots pick their own.
FORCE_MODEL=

# Hard ceiling on max_tokens per request, applied server-side.
MAX_TOKENS_CAP=4096

# ---- limits --------------------------------------------------------------
MAX_BODY_BYTES=262144
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MIN=15
