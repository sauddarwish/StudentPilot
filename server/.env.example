# ==========================================================================
# Cram server configuration
#
# Copy to server/.env, then:  node set-password.js
# .env must be mode 600 and is git-ignored, never commit it.
# ==========================================================================

# ---- where the process listens (nginx proxies to this) --------------------
HOST=127.0.0.1
PORT=8080

# ---- accounts ------------------------------------------------------------
# Users sign up with email + password at /signup. Accounts live in
# server/users.json (mode 600); passwords are stored as scrypt hashes.
# Seed or add accounts from the CLI with:  node add-user.js <email>

# Both are generated for you by:  node gen-secrets.js

# Signs session cookies. Any long random string; changing it logs everyone out.
SESSION_SECRET=

# 32 bytes, base64 or hex. Encrypts API keys users choose to store on the server
# (AES-256-GCM). Leave empty and that feature is simply unavailable.
# WARNING: changing this makes every already-stored key undecryptable.
ENCRYPTION_KEY=

# Set to false to close registration (existing accounts still work).
ALLOW_SIGNUP=true

SESSION_DAYS=14
SECURE_COOKIE=true

# ---- optional shared API key ---------------------------------------------
# Leave BOTH empty and every user simply brings their own key in the UI.
# If you do set one, /api/v1 becomes a shared endpoint any signed-in user can
# point at, the key is attached server-side and never reaches the client.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- shared endpoint limits ----------------------------------------------
# These apply only to requests that go through THIS server's key (/api/v1).
# Users supplying their own key call the provider directly and are unaffected.

# If set, this model is forced onto every request regardless of what the
# client asked for. Leave empty to let pilots pick their own.
FORCE_MODEL=

# Hard ceiling on max_tokens per request, applied server-side.
MAX_TOKENS_CAP=8192

# ---- web access ----------------------------------------------------------
# Lets the models search and read pages. Set to false to switch the tools off.
ALLOW_WEB=true

# Search backend. With neither set, web_search falls back to Wikipedia only,
# which is a real API that will not break, but is obviously narrow. fetch_url
# still reaches any public page either way. A free Brave key lifts the limit:
# https://brave.com/search/api/
BRAVE_API_KEY=
# Or point at your own SearXNG instance (may be on the local network):
SEARXNG_URL=

# ---- limits --------------------------------------------------------------
# 16 MB: image attachments are base64 in the request body
MAX_BODY_BYTES=16777216
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MIN=15
