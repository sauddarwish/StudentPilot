[Unit]
Description=Cram (password-gated site + model proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/cram/server
ExecStart=/usr/bin/node /opt/cram/server/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cram/server
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# NOTE: no MemoryDenyWriteExecute — V8's JIT needs W+X and traps without it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
